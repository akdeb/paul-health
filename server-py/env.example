DEEPGRAM_API_KEY=your_deepgram_api_key
OPENAI_API_KEY=your_openai_api_key
CARTESIA_API_KEY=your_cartesia_api_key
CURRENT_VOICE_ROUTE=openai_realtime
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=ash

# WebSocket server settings
PIPECAT_WEBSOCKET_HOST=0.0.0.0
PIPECAT_WEBSOCKET_PORT=8765

# Input-audio cleanup for quiet/noisy mics (high-pass + adaptive gain).
# Sample-for-sample only; does not affect device-driven turn-taking.
AUDIO_ENHANCE_ENABLED=true
AUDIO_ENHANCE_TARGET_RMS=3000.0
AUDIO_ENHANCE_MAX_GAIN=8.0

# ESP32 speaker loudness (gain + tanh soft-clip limiter, ported from elato-local).
# Applied to the Opus output path only. +7 dB matches elato.
AUDIO_OUTPUT_BOOST_ENABLED=true
AUDIO_OUTPUT_GAIN_DB=7.0

# Long-term patient memory (Mem0 OSS, self-hosted on Supabase pgvector + Gemini).
# Just the DB password -- the pooler host is pinned in memory.py. Needs
# GEMINI_API_KEY/GOOGLE_API_KEY too. Memory is disabled if this is unset.
SUPABASE_DB_PASSWORD=your-supabase-database-password
# Optional: a full connection string overrides the pinned host (e.g. new project).
# SUPABASE_DB_URL=postgresql://postgres.<ref>:password@aws-1-<region>.pooler.supabase.com:5432/postgres
MEM0_LLM_MODEL=gemini-2.5-flash
MEM0_COLLECTION=patient_memories
